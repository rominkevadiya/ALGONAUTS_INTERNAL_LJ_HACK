# ==============================================================================
# SignalScope - Comprehensive .gitignore
# ==============================================================================

# Python Bytecode & Compiled Files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Streamlit Runtime Caches & Configs
.streamlit/

# Testing & Coverage Caches
.pytest_cache/
.coverage
htmlcov/
.hypothesis/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
*.tmp
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Build, Distribution & Package Metadata
build/
dist/
*.egg-info/
*.egg
*.manifest
*.spec

# Logs & Temporary Downloads
*.log
scratch/

# Legacy Nested Folder
ALGONAUTS_INTERNAL_LJ_HACK-main/

.env

# Large Model Weights (Keep primary model, ignore checkpoints)
model_checkpoints/*.pth
model_checkpoints/*.pt

# Deployment and Secrets
deploy_aws.py
*.pem
